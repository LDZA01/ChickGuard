# ChickGuard Configuration
# Copy this file to .env and fill in your values

# ==================== LINE Messaging API ====================
# Get from: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# ==================== Email Configuration ====================
# Gmail setup: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ==================== System Configuration ====================
# Video source: "synthetic", 0 (webcam), or "rtsp://..." (IP camera)
VIDEO_SOURCE=synthetic

# YOLO model path (relative to backend directory)
YOLO_MODEL_PATH=yolov8n.pt

# Processing settings
CONFIDENCE_THRESHOLD=0.5
PROCESS_FPS=5

# Alert settings
ALERT_COOLDOWN_MINUTES=15
MEDIUM_RISK_THRESHOLD=40
HIGH_RISK_THRESHOLD=70

# Server settings
HOST=0.0.0.0
PORT=8000
